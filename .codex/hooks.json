{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Ads/_TOOLS/hook_csv.py\"",
            "timeout": 120,
            "statusMessage": "Validando CSV y regenerando dashboard..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Ads/_TOOLS/hook_csv.py\" --barrido",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/Ads/_TOOLS/archivar_auditorias.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
