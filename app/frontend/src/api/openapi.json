{
  "openapi": "3.1.0",
  "info": {
    "title": "VitalCom",
    "summary": "La pantalla del sistema VITALCOM Guatemala (solo lectura, Hito 1).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/productos": {
      "get": {
        "tags": [
          "productos"
        ],
        "summary": "Listar Productos",
        "description": "El portafolio: la fila del CSV más la fase y el nodo vigentes del estado derivado.\n\nLa fase que se sirve es la de `_ESTADO_FLUJO.csv` (derivada). La columna `fase` de\n`_DIM_PRODUCTOS.csv` viaja aparte, como `fase_bitacora`, para que nadie las confunda.",
        "operationId": "listar_productos_api_productos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Producto"
                  },
                  "type": "array",
                  "title": "Response Listar Productos Api Productos Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "productos"
        ],
        "summary": "Alta De Producto",
        "description": "Da de alta el producto con `alta_producto.py` y re-evalúa el flujo.\n\nLa imagen y la descripción se guardan primero en una carpeta temporal; quien las mete\nen el sistema —y quien declara el packshot en `_DIM_ENVASE.csv`— es el script.",
        "operationId": "alta_de_producto_api_productos_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_alta_de_producto_api_productos_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Alta De Producto Api Productos Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/productos/{producto_key}": {
      "get": {
        "tags": [
          "productos"
        ],
        "summary": "Detalle Producto",
        "description": "El recorrido completo del producto en el grafo, tal como lo evalúa `flujo.py`.",
        "operationId": "detalle_producto_api_productos__producto_key__get",
        "parameters": [
          {
            "name": "producto_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flujo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/decisiones": {
      "get": {
        "tags": [
          "decisiones"
        ],
        "summary": "Listar Decisiones",
        "description": "Las órdenes vigentes de `decidir.py`. La app las muestra; no las recalcula.",
        "operationId": "listar_decisiones_api_decisiones_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decisiones"
                }
              }
            }
          }
        }
      }
    },
    "/api/salud": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Estado Del Sistema",
        "description": "Qué vista está fresca y quién la produce, según `gen_app.py`.",
        "operationId": "estado_del_sistema_api_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          }
        }
      }
    },
    "/api/costeo/{costo_q}": {
      "get": {
        "tags": [
          "productos"
        ],
        "summary": "Costeo",
        "description": "La tabla de precios de Guatemala para un costo, tal como la devuelve `costear.py`.\n\nLa app no calcula ni un centavo: pregunta y muestra. Si el costo cae entre dos filas de\n`_DIM_COSTEO.csv`, el script toma la superior y lo dice en `criterio_de_fila`\n(invariante 2).",
        "operationId": "costeo_api_costeo__costo_q__get",
        "parameters": [
          {
            "name": "costo_q",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Costo Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Costeo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/productos/{producto_key}/transcribir": {
      "post": {
        "tags": [
          "productos"
        ],
        "summary": "Transcribir Videos",
        "description": "Pasa a texto los videos del producto con `transcribir_videos.py`, en esta máquina.",
        "operationId": "transcribir_videos_api_productos__producto_key__transcribir_post",
        "parameters": [
          {
            "name": "producto_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Key"
            }
          },
          {
            "name": "modelo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "small",
              "title": "Modelo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Transcribir Videos Api Productos  Producto Key  Transcribir Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sistema": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Donde Corre",
        "description": "Sobre qué carpeta está corriendo la app. Evita el error del worktree (hoja §1.2).",
        "operationId": "donde_corre_api_sistema_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Donde Corre Api Sistema Get"
                }
              }
            }
          }
        }
      }
    }
  },
