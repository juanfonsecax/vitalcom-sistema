    create  table
      "vitalcom"."main"."stg_productos__dbt_tmp"
  
    
    as (
      -- El registro maestro. producto_key es la llave del sistema (invariante 10).
select
    trim(producto_key)                                as producto_key,
    trim(nombre_display)                              as nombre,
    upper(trim(estado))                               as estado,
    nullif(upper(trim(fase)),'')                      as fase,
    nullif(trim(cuenta_alias),'')                     as cuenta_alias,
    cast(nullif(trim(cpa_be_q),'') as double)         as cpa_be_q,
    cast(nullif(trim(cpa_base_q),'') as double)       as cpa_base_q,
    cast(nullif(trim(precio_base_q),'') as double)    as precio_base_q,
    nullif(trim(page_id),'')                          as page_id,
    nullif(trim(campaign_id),'')                      as campaign_id
from read_csv('../PRODUCTOS/_DIM_PRODUCTOS.csv', header=true, all_varchar=true)
where nullif(trim(producto_key),'') is not null
    );
    
  
17:51:09.757550 [debug] [Thread-1 (]: SQL status: OK in 0.002 seconds
17:51:09.758092 [debug] [Thread-1 (]: Using duckdb connection "model.vitalcom.stg_alias"
17:51:09.758409 [debug] [Thread-1 (]: On model.vitalcom.stg_alias: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "vitalcom", "target_name": "dev", "node_id": "model.vitalcom.stg_alias"} */

    

    create  table
      "vitalcom"."main"."stg_alias__dbt_tmp"
  
    
    as (
      -- El nombre viejo de un conjunto renombrado en Meta -> su nombre canonico.
-- El JOIN del sistema es por NOMBRE (el ad_id llego corrupto en 2006 de 2475 filas y no vuelve),
-- asi que sin esto un renombrado parte la serie historica en dos objetos distintos.
select
    trim(nombre_viejo) as nombre_viejo,
    trim(nombre_nuevo) as nombre_nuevo
from read_csv('../PRODUCTOS/_ALIAS_CONJUNTOS.csv', header=true, all_varchar=true)
where nullif(trim(nombre_viejo),'') is not null
  and nullif(trim(nombre_nuevo),'') is not null
  and trim(nombre_viejo) <> trim(nombre_nuevo)
    );
    
  
