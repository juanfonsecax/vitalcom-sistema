    create  table
      "vitalcom"."main"."stg_ventas__dbt_tmp"
  
    
    as (
      -- Ventas por dia. FUENTE DE VERDAD de la venta (LucidSales); Meta solo aporta entrega.
with v as (
    select * from read_csv('../PRODUCTOS/_FACT_VENTAS.csv', header=true, all_varchar=true)
)
select
    cast(v.ventana_fin as date)                       as fecha,
    trim(v.producto_key)                              as producto_key,
    trim(v.cuenta_alias)                              as cuenta_alias,
    trim(v.campana)                                   as campana,
    coalesce(a.nombre_nuevo, trim(v.conjunto))        as conjunto,
    nullif(trim(v.anuncio),'')                        as anuncio,
    cast(v.ventas as double)                          as ventas,
    cast(v.mensajes as double)                        as mensajes,
    cast(v.spend_usd as double)                       as spend_usd,
    cast(nullif(trim(v.total_q),'') as double)        as total_q
from v
left join "vitalcom"."main"."stg_alias" a on trim(v.conjunto) = a.nombre_viejo
where nullif(trim(v.conjunto),'') is not null
  and trim(v.conjunto) <> 'SIN_ATRIBUCION'
    );
    
  
19:20:26.548415 [debug] [Thread-1 (]: On model.vitalcom.stg_bandas: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "vitalcom", "target_name": "dev", "node_id": "model.vitalcom.stg_bandas"} */

    

    create  table
      "vitalcom"."main"."stg_bandas__dbt_tmp"
  
    
    as (
      -- La banda de edad REALMENTE configurada en Meta, contra la que manda la doctrina.
select
    trim(cuenta_alias)                                as cuenta_alias,
    coalesce(a.nombre_nuevo, trim(b.conjunto_meta))   as conjunto,
    trim(b.producto_key)                              as producto_key,
    trim(b.angulo_key)                                as angulo_key,
    trim(b.banda_configurada)                         as banda_configurada,
    trim(b.avatar_edad_doctrina)                      as banda_doctrina,
    upper(trim(b.coincide)) = 'SI'                    as coincide
from read_csv('../PRODUCTOS/_DIM_BANDAS.csv', header=true, all_varchar=true) b
left join "vitalcom"."main"."stg_alias" a on trim(b.conjunto_meta) = a.nombre_viejo
    );
    
  
